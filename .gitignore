# Dependencies (created by `bun install`)
node_modules/

# Build output
dist/
/artifacts/

# Runtime-generated artifacts — keep the directory structure (READMEs) tracked,
# ignore everything written at runtime.

# Generated capability snapshots: capabilities/<id>/<incarnation_id>/v<n>/
# (authored spec history + .ts handlers/item renderer + optional frozen tests)
capabilities/*
!capabilities/README.md

# Object-store blobs: storage/<key>
storage/*
!storage/README.md

# SQLite database file + its WAL/SHM/journal sidecars
data/*
!data/README.md

# Env vars
.env

# macOS Finder metadata
.DS_Store

# Local notes and plans, kept out of the repo
.internal/
/modules/

# Local AI-agent setup, kept out of the repo
.agents/
.claude/
.codex/
/skills-lock.json

# Declarations published from the browser JSDoc by `tsc -p tsconfig.browser.json`,
# so `src` can import a browser module. Regenerated by `bun run typecheck`.
.types/
